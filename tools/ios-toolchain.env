# What the iOS goldens are rendered with, locally and on CI. Another Xcode or
# simulator anti-aliases differently, so tools/check.sh refuses to compare
# under anything else. Changing a line here means re-recording the goldens.
XCODE_VERSION=26.3
IOS_RUNTIME=26.2
IOS_DEVICE="iPhone 17 Pro"
CHECK_SIMULATOR="ChargeAhead Checks"
